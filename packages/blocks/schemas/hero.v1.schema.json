{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ui8kit:content:hero:1",
  "title": "hero@1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "title"
  ],
  "properties": {
    "badge": {
      "title": "Badge",
      "type": "string",
      "maxLength": 40,
      "x-ui8-type": "text"
    },
    "title": {
      "title": "Title",
      "type": "string",
      "maxLength": 120,
      "pattern": "\\S",
      "x-ui8-type": "text"
    },
    "description": {
      "title": "Description",
      "type": "string",
      "maxLength": 400,
      "x-ui8-type": "longText"
    },
    "image": {
      "title": "Image",
      "$ref": "#/$defs/image"
    },
    "actionLabel": {
      "title": "Button label",
      "type": "string",
      "maxLength": 40,
      "x-ui8-type": "text"
    },
    "actionHref": {
      "title": "Button link",
      "type": "string",
      "format": "uri-reference",
      "pattern": "^(?!\\s*(?:[jJ][aA][vV][aA][sS][cC][rR][iI][pP][tT]|[vV][bB][sS][cC][rR][iI][pP][tT]|[dD][aA][tT][aA]):)",
      "x-ui8-type": "url"
    }
  },
  "$defs": {
    "image": {
      "type": "object",
      "required": [
        "src",
        "alt"
      ],
      "additionalProperties": false,
      "properties": {
        "src": {
          "type": "string",
          "format": "uri-reference",
          "pattern": "^(?:|[hH][tT][tT][pP][sS]://[^\\s/?#]+[^\\s]*|/(?![/\\\\])[^\\s]*)$"
        },
        "alt": {
          "type": "string"
        },
        "srcDark": {
          "type": "string",
          "format": "uri-reference",
          "pattern": "^(?:|[hH][tT][tT][pP][sS]://[^\\s/?#]+[^\\s]*|/(?![/\\\\])[^\\s]*)$"
        }
      }
    }
  }
}
