{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ui8kit:content:team:1",
  "title": "team@1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "title",
    "members"
  ],
  "properties": {
    "title": {
      "title": "Title",
      "type": "string",
      "maxLength": 120,
      "pattern": "\\S",
      "x-ui8-type": "text"
    },
    "description": {
      "title": "Description",
      "type": "string",
      "maxLength": 400,
      "x-ui8-type": "longText"
    },
    "members": {
      "title": "Members",
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "$ref": "#/$defs/teamMember"
      }
    }
  },
  "$defs": {
    "image": {
      "type": "object",
      "required": [
        "src",
        "alt"
      ],
      "additionalProperties": false,
      "properties": {
        "src": {
          "type": "string",
          "format": "uri-reference",
          "pattern": "^(?:|[hH][tT][tT][pP][sS]://[^\\s/?#]+[^\\s]*|/(?![/\\\\])[^\\s]*)$"
        },
        "alt": {
          "type": "string"
        },
        "srcDark": {
          "type": "string",
          "format": "uri-reference",
          "pattern": "^(?:|[hH][tT][tT][pP][sS]://[^\\s/?#]+[^\\s]*|/(?![/\\\\])[^\\s]*)$"
        }
      }
    },
    "teamMember": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title"
      ],
      "properties": {
        "avatar": {
          "title": "Photo",
          "$ref": "#/$defs/image"
        },
        "title": {
          "title": "Name",
          "type": "string",
          "maxLength": 80,
          "pattern": "\\S",
          "x-ui8-type": "text"
        },
        "description": {
          "title": "Role",
          "type": "string",
          "maxLength": 240,
          "x-ui8-type": "longText"
        }
      }
    }
  }
}
