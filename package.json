{
  "name": "prototypes",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "packageManager": "bun@1.2.21",
  "scripts": {
    "dev": "bun run --filter @ui8kit/blocks-app dev",
    "build": "bun run --filter @ui8kit/blocks-app build && node scripts/catalog-size.mjs",
    "verify": "node scripts/verify.mjs",
    "catalog:build": "node scripts/catalog-size.mjs",
    "test": "vitest run",
    "test:node": "node --experimental-strip-types --import ./scripts/ts-ext-register.mjs --test packages/theme/src/*.test.ts packages/blocks/src/manifest/*.node.test.ts",
    "test:theme": "node --experimental-strip-types --import ./scripts/ts-ext-register.mjs --test packages/theme/src/*.test.ts",
    "test:manifest": "node --experimental-strip-types --import ./scripts/ts-ext-register.mjs --test packages/blocks/src/manifest/*.node.test.ts",
    "typecheck": "tsc --noEmit",
    "check:blocks": "node --experimental-strip-types scripts/check-blocks.ts",
    "check:rules": "node --experimental-strip-types scripts/check-rules.ts",
    "check:codegen": "node --experimental-strip-types scripts/sync-codegen.ts --check",
    "sync:codegen": "node --experimental-strip-types scripts/sync-codegen.ts",
    "px": "node scripts/ui8px-gate.mjs",
    "px:extract": "node --experimental-strip-types --import ./scripts/ts-ext-register.mjs scripts/px-extract.ts",
    "px:cli": "node scripts/ui8px.mjs",
    "kit:install": "bash scripts/install-kit.sh"
  },
  "ui8kit": {
    "runtime": "svelte",
    "aria": {
      "mode": "full",
      "patterns": []
    }
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^6.2.1",
    "@tailwindcss/vite": "^4.1.13",
    "@testing-library/svelte": "^5.2.8",
    "@types/node": "^22.10.0",
    "@ui8kit/contract": "github:ui8kit/contract#20d0853fba892410dd42a92ac9adfa8241d0880a",
    "ajv": "^8.17.1",
    "jsdom": "^26.1.0",
    "svelte": "^5.39.6",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.8.3",
    "ui8px": "github:ui8kit/ui8px-cli#05f4a3edd0054c33e0358e5552a9829442237ed8",
    "vite": "^7.1.7",
    "vitest": "^3.2.4"
  }
}
